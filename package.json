{
  "name": "@bbc/sqs-extended",
  "version": "0.0.3",
  "description": "Handles large SQS payloads by offloading message bodies to S3 automatically.",
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -fr dist/*",
    "compile": "tsc -b ./tsconfig.cjs.json ./tsconfig.esm.json",
    "add-package-jsons": "node ./scripts/addPackageJsons.js",
    "build": "pnpm run clean && pnpm run compile && pnpm run add-package-jsons",
    "watch": "tsc --watch",
    "prepublishOnly": "pnpm run build",
    "test:unit": "vitest run",
    "test:unit:report": "vitest run --reporter=junit --outputFile=test/reports/test-results.xml",
    "test": "pnpm run test:unit:report",
    "coverage": "vitest run --coverage --coverage.reporter=html --coverage.reporter=json-summary",
    "lcov": "vitest run --coverage --coverage.reporter=lcov",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "generate-docs": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbc/sqs-extended.git"
  },
  "bugs": {
    "url": "https://github.com/bbc/sqs-extended/issues"
  },
  "homepage": "https://bbc.github.io/sqs-extended/",
  "keywords": [
    "sqs",
    "queue",
    "consumer",
    "producer",
    "s3",
    "large-payloads"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "provenance": true
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.10.5",
    "@types/sinon": "^17.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "p-event": "^7.1.0",
    "semantic-release": "^25.0.3",
    "sinon": "^21.0.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "uuid": "^14.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.989.0",
    "@aws-sdk/client-sqs": "^3.989.0",
    "sqs-consumer": "latest",
    "sqs-producer": "latest"
  }
}
